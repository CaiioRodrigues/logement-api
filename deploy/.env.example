# Copie para .env e preencha. O arquivo .env nao vai para o git.
#
#   cp .env.example .env

# --- Endereco ---

# Precisa ja apontar para o IP deste servidor antes da primeira subida:
# o Caddy pede o certificado consultando o DNS.
DOMINIO=condominio.exemplo.com.br

# Para onde a Let's Encrypt avisa que o certificado vai vencer.
EMAIL_DO_CERTIFICADO=voce@exemplo.com

# --- Banco ---

POSTGRES_DB=convivium
POSTGRES_USER=convivium

# Gere uma e guarde:  openssl rand -base64 24
POSTGRES_PASSWORD=TROQUE-ISTO

# --- Sessao ---

# A API se recusa a subir com menos de 32 bytes. Gere com:
#   openssl rand -base64 48
#
# Trocar esta chave derruba todas as sessoes abertas. Nao e problema — e o
# que se faz se ela vazar.
JWT_SIGNING_KEY=TROQUE-ISTO

# Quem administra a plataforma e pode criar condominios. Na primeira subida,
# se esta pessoa ainda nao existir, ela e criada sem senha e o link de
# primeiro acesso sai no log:  docker compose logs api | grep convite
SUPER_ADMIN_EMAIL=voce@exemplo.com

# --- Rede interna ---

# Faixa do Docker, usada para a API confiar no X-Forwarded-For do Caddy.
# So mude se colidir com outra rede da maquina.
REDE_INTERNA=172.28.0.0/16

# --- E-mail ---

# Convite, boleto e redefinicao de senha saem por aqui. Sem SMTP valido o
# sistema funciona, mas ninguem recebe nada.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=resend
SMTP_PASSWORD=TROQUE-ISTO
SMTP_FROM=nao-responda@seudominio.com.br
SMTP_FROM_NAME=Convivium

# --- Boleto bancario ---

# Chave que cifra as credenciais do banco de cada condominio (client secret
# e certificado) no Postgres. Sem ela o sistema sobe normalmente, mas a tela
# "Banco e boleto" nao deixa gravar nada. Gere com:
#   openssl rand -base64 32
#
# Guarde FORA do servidor tambem. O backup do Postgres leva as credenciais
# cifradas, nao a chave: perdida a chave, cada condominio precisa cadastrar
# o client secret e o certificado de novo. Trocar a chave tem o mesmo efeito.
APP_SECRETS_KEY=TROQUE-ISTO

# De quantos em quantos minutos o sistema confere os boletos em aberto com o
# banco e da baixa no caixa dos que foram pagos.
BOLETO_CONFERENCIA_MINUTOS=30

# --- Backup ---

# Quantos dias de copia ficam no servidor.
DIAS_DE_BACKUP=14
